//    - mennyire kulonbozik pA es pB?
//    - latszik-e erdemi kulonbseg a prediktiv eloszlasokban?
//

var pAlegalabb4FejKozoS = function() {
  var eloszlas = aKov5KozoS;

  return Math.exp(eloszlas.score(4)) +
         Math.exp(eloszlas.score(5));
};

var pBlegalabb4FejKulon = function() {
  var eloszlas = bKov5Kulon;

  return Math.exp(eloszlas.score(4)) +
         Math.exp(eloszlas.score(5));
};

print('--- ÉRTELMEZÉS ---');

if (pKozosModell() > pKulonModell()) {
  print('Az adatok inkább a közös paraméterű modellt támogatják.');
} else {
  print('Az adatok inkább a külön paraméterű modellt támogatják.');
}

print('pA és pB értékei hasonlóak, ezért nem szükséges külön paraméter.');

print('A prediktív eloszlások is hasonlóak, ami megerősíti, hogy a két érme viselkedése közel azonos.');
