// ------------------------------

// A valódi súly átlagának kiszámítása
// (külön mintavétellel, hogy biztosan működjön)
var sulyMintak = repeat(3000, function() {
  return sample(sulyPoszterior);
});

var becsultAtlagSuly = atlag(sulyMintak);

print('--- ÉRTELMEZÉS ---');

// Melyik modell valószínűbb?
if (pEgeszseges() > pBeteg()) {

  print('Az adatok alapján az egészséges modell a valószínűbb.');

  print('Ez azt jelenti, hogy a mért súlyok');
  print('közelebb állnak a 22 gramm körüli');
  print('egészséges állatokhoz.');

} else {

  print('Az adatok alapján a beteg modell a valószínűbb.');

  print('Ez azt jelenti, hogy a mért súlyok');
  print('közelebb állnak a 17 gramm körüli');
  print('beteg állatokhoz.');
}

// Mennyire biztos a döntés?
var kulonbseg = Math.abs(
  pEgeszseges() - pBeteg()
);

if (kulonbseg > 0.8) {

  print('A döntés nagyon egyértelmű.');

} else if (kulonbseg > 0.4) {

  print('A döntés viszonylag egyértelmű.');

} else {

  print('A két modell között nincs nagy különbség.');
}

// A valódi súly értelmezése
print('A becsült valódi súly:');
